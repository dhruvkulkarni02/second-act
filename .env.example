# Microsoft Foundry project endpoint and model deployment (used by FoundryChatClient).
FOUNDRY_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=<your-model-deployment-name>
# Reasoning effort for gpt-5 / o-series deployments. 'minimal' keeps the half-time
# briefing inside its 30 s budget on gpt-5-mini; newer models may need 'none' or 'low'.
# Leave empty to omit the setting.
FOUNDRY_REASONING_EFFORT=minimal

# Run all agents with deterministic template output and no model calls.
SECOND_ACT_OFFLINE=false

# Where session logs are written (JSONL, gitignored).
SECOND_ACT_LOG_DIR=logs

# Half-time workflow: seconds allowed before falling back to the template briefing,
# and how many drafts the tactician writes in parallel per round.
SECOND_ACT_HALFTIME_BUDGET_S=25
SECOND_ACT_PARALLEL_DRAFTS=2
