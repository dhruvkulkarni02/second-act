# Microsoft Foundry project endpoint and model deployment (used by FoundryChatClient).
FOUNDRY_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=<your-model-deployment-name>

# Run all agents with deterministic template output and no model calls.
SECOND_ACT_OFFLINE=false

# Where session logs are written (JSONL, gitignored).
SECOND_ACT_LOG_DIR=logs
